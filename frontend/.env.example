# Local development defaults. These may be omitted because the frontend uses
# the same defaults in code.
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Used only by Vite's local development proxy.
VITE_BACKEND_URL=http://localhost:5000

# On the frontend hosting platform, replace the first two values with the
# deployed backend's public HTTPS URL and rebuild the frontend.
